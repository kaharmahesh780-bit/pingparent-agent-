<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b1120">

    <!-- 1. PIN Lock & Recovery Screen -->
    <LinearLayout
        android:id="@+id/pinContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Parent Access"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDisplayPairingCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pairing Code: --"
            android:textColor="#34d399"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPin"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="#1e293b"
            android:gravity="center"
            android:hint="Enter 4-Digit PIN"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:textColor="#ffffff"
            android:textColorHint="#64748b" />

        <TextView
            android:id="@+id/tvPinError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Incorrect PIN!"
            android:textColor="#ef4444"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="#10b981"
            android:text="Unlock"
            android:textColor="#0b1120"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvForgotPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:text="Forgot PIN? Use Pairing Code"
            android:textColor="#94a3b8"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- 2. Inside Settings Panel (Unlocked) -->
    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PingParent Agent"
            android:textColor="#34d399"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAgentCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pairing Code: --"
            android:textColor="#94a3b8"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Service Active &amp; Protected"
            android:textColor="#cbd5e1"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:background="#3b82f6"
            android:text="Manage Permissions"
            android:textColor="#ffffff"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLockApp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="#334155"
            android:text="Lock App Again"
            android:textColor="#ffffff"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
